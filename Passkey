  "content": "#!/usr/bin/env node\n\n/**\n * Offline Security Audit Tool\n * Scans package-lock.json for known vulnerabilities without internet connection\n * Usage: node scripts/offline-security-audit.js [--verbose] [--format json|text]\n */\n\nconst fs = require('fs');\nconst path = require('path');\n\nconst args = process.argv.slice(2);\nconst verbose = args.includes('--verbose');\nconst format = args.includes('--format') ? args[args.indexOf('--format') + 1] : 'text';\n\n// Known vulnerable packages and their version ranges\n// This database should be updated regularly when online\nconst VULNERABILITY_DB = {\n  lodash: {\n    name: 'lodash',\n    vulnerabilities: [\n      {\n        id: 'GHSA-35jh-r3h4-6jhm',\n        severity: 'high',\n        title: 'Prototype Pollution',\n        affected: ['<4.17.21'],\n        fixed: '4.17.21',\n      },\n      {\n        id: 'GHSA-fvqr-27wr-82cm',\n        severity: 'medium',\n        title: 'ReDoS',\n        affected: ['<4.17.21'],\n        fixed: '4.17.21',\n      },\n    ],\n  },\n  'lodash-es': {\n    name: 'lodash-es',\n    vulnerabilities: [\n      {\n        id: 'GHSA-35jh-r3h4-6jhm',\n        severity: 'high',\n        title: 'Prototype Pollution',\n        affected: ['<4.17.21'],\n        fixed: '4.17.21',\n      },\n    ],\n  },\n  debug: {\n    name: 'debug',\n    vulnerabilities: [\n      {\n        id: 'GHSA-gf8q-jrpm-jvxq',\n        severity: 'high',\n        title: 'Improper Removal of Sensitive Information',\n        affected: ['<3.1.0', '>=4.0.0 <4.3.1'],\n        fixed: '4.3.5',\n      },\n    ],\n  },\n  chalk: {\n    name: 'chalk',\n    vulnerabilities: [\n      {\n        id: 'GHSA-chw6-4fwf-5jhg',\n        severity: 'critical',\n        title: 'Malicious code in chalk v5.0.0',\n        affected: ['5.0.0'],\n        fixed: '5.0.1',\n      },\n    ],\n  },\n  'cross-spawn': {\n    name: 'cross-spawn',\n    vulnerabilities: [\n      {\n        id: 'GHSA-3xgq-45jj-v275',\n        severity: 'high',\n        title: 'ReDoS Vulnerability',\n        affected: ['<6.0.6', '>=7.0.0 <7.0.5'],\n        fixed: '6.0.6 or 7.0.5+',\n      },\n    ],\n  },\n  sharp: {\n    name: 'sharp',\n    vulnerabilities: [\n      {\n        id: 'GHSA-2r3p-4xvc-w6x4',\n        severity: 'medium',\n        title: 'Binary vulnerability in older versions',\n        affected: ['<0.31.0'],\n        fixed: '0.31.0+',\n      },\n    ],\n  },\n  undici: {\n    name: 'undici',\n    vulnerabilities: [\n      {\n        id: 'GHSA-8v99-48c9-8686',\n        severity: 'medium',\n        title: 'HTTP Request Smuggling',\n        affected: ['<5.28.3'],\n        fixed: '5.28.3 or 6.x',\n      },\n    ],\n  },\n  axios: {\n    name: 'axios',\n    vulnerabilities: [\n      {\n        id: 'GHSA-wf5p-g6fw-gc69',\n        severity: 'high',\n        title: 'Prototype Pollution',\n        affected: ['<1.6.0'],\n        fixed: '1.6.0+',\n      },\n    ],\n  },\n};\n\nfunction compareVersions(version, constraint) {\n  // Simple version comparison - this is a basic implementation\n  const vParts = version.split('.').map(Number);\n  const cParts = constraint.split('.').map(Number);\n\n  for (let i = 0; i < Math.max(vParts.length, cParts.length); i++) {\n    const vPart = vParts[i] || 0;\n    const cPart = cParts[i] || 0;\n    if (vPart > cPart) return 1;\n    if (vPart < cPart) return -1;\n  }\n  return 0;\n}\n\nfunction isVulnerable(version, affectedRanges) {\n  return affectedRanges.some((range) => {\n    if (range.includes('<')) {\n      const fixed = range.replace('<', '');\n      return compareVersions(version, fixed) < 0;\n    }\n    if (range.includes('>=')) {\n      const parts = range.split(' ');\n      const lower = parts[0].replace('>=', '');\n      const upper = parts[2].replace('<', '');\n      return compareVersions(version, lower) >= 0 && compareVersions(version, upper) < 0;\n    }\n    return version === range;\n  });\n}\n\nfunction readLockFile() {\n  const lockPath = path.join(process.cwd(), 'package-lock.json');\n  if (!fs.existsSync(lockPath)) {\n    console.error('❌ package-lock.json not found');\n    process.exit(1);\n  }\n  return JSON.parse(fs.readFileSync(lockPath, 'utf8'));\n}\n\nfunction scanDependencies(lockFile) {\n  const vulnerabilities = [];\n  const packages = lockFile.packages || {};\n\n  Object.entries(VULNERABILITY_DB).forEach(([pkgName, pkgData]) => {\n    const nodeModulesPath = `node_modules/${pkgName}`;\n\n    if (packages[nodeModulesPath]) {\n      const installedVersion = packages[nodeModulesPath].version;\n\n      pkgData.vulnerabilities.forEach((vuln) => {\n        if (isVulnerable(installedVersion, vuln.affected)) {\n          vulnerabilities.push({\n            package: pkgName,\n            version: installedVersion,\n            vulnerability: vuln,\n          });\n        }\n      });\n    }\n  });\n\n  return vulnerabilities;\n}\n\nfunction formatTextOutput(vulnerabilities) {\n  if (vulnerabilities.length === 0) {\n    console.log('\\n✅ No known vulnerabilities detected in offline database\\n');\n    return;\n  }\n\n  console.log('\\n🚨 SECURITY VULNERABILITIES DETECTED\\n');\n  console.log(`Found ${vulnerabilities.length} vulnerability(ies):\\n`);\n\n  const groupedByPackage = {};\n  vulnerabilities.forEach((vuln) => {\n    if (!groupedByPackage[vuln.package]) {\n      groupedByPackage[vuln.package] = [];\n    }\n    groupedByPackage[vuln.package].push(vuln);\n  });\n\n  Object.entries(groupedByPackage).forEach(([pkgName, vulns]) => {\n    console.log(`\\n📦 ${pkgName}`);\n    console.log('─'.repeat(50));\n\n    vulns.forEach((vuln) => {\n      const severity = vuln.vulnerability.severity.toUpperCase();\n      const severityEmoji = {\n        CRITICAL: '🔴',\n        HIGH: '🟠',\n        MEDIUM: '🟡',\n        LOW: '🟢',\n      }[severity] || '⚫';\n\n      console.log(`  ${severityEmoji} [${severity}] ${vuln.vulnerability.title}`);\n      console.log(`     Installed: ${vuln.version}`);\n      console.log(`     Fixed in: ${vuln.vulnerability.fixed}`);\n      console.log(`     ID: ${vuln.vulnerability.id}\\n`);\n    });\n  });\n\n  if (verbose) {\n    console.log('\\n📋 REMEDIATION STEPS:\\n');\n    Object.entries(groupedByPackage).forEach(([pkgName, vulns]) => {\n      const fixedVersion = vulns[0].vulnerability.fixed;\n      console.log(`  npm update ${pkgName}@${fixedVersion}`);\n    });\n  }\n\n  console.log('\\n⚠️  Next steps when online:');\n  console.log('  1. Run: npm audit');\n  console.log('  2. Run: npm audit fix');\n  console.log('  3. Run: npm test');\n  console.log('  4. Commit changes\\n');\n}\n\nfunction formatJsonOutput(vulnerabilities) {\n  const output = {\n    timestamp: new Date().toISOString(),\n    totalVulnerabilities: vulnerabilities.length,\n    vulnerabilities: vulnerabilities.map((v) => ({\n      package: v.package,\n      installedVersion: v.version,\n      severity: v.vulnerability.severity,\n      title: v.vulnerability.title,\n      id: v.vulnerability.id,\n      fixedInVersion: v.vulnerability.fixed,\n    })),\n  };\n  console.log(JSON.stringify(output, null, 2));\n}\n\nfunction main() {\n  try {\n    const lockFile = readLockFile();\n    const vulnerabilities = scanDependencies(lockFile);\n\n    if (format === 'json') {\n      formatJsonOutput(vulnerabilities);\n    } else {\n      formatTextOutput(vulnerabilities);\n    }\n\n    if (vulnerabilities.some((v) => v.vulnerability.severity === 'critical')) {\n      process.exit(2);\n    } else if (vulnerabilities.length > 0) {\n      process.exit(1);\n    }\n  } catch (error) {\n    console.error('❌ Error during security audit:', error.message);\n    process.exit(3);\n  }\n}\n\nmain();\n",
